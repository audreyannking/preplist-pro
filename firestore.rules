rules_version = '2';

// PrepList Pro — Firestore security rules.
//
// This app has NO accounts and NO login (by design — anyone can just pick a
// role and use the site). That means there is no `request.auth` to check,
// so these rules are fully open: anyone who can reach this database can
// read and write anything in it. The Teacher/Admin access password in
// index.html is a light deterrent for casual visitors, not real security —
// it lives in the page's own source code, and nothing here enforces it.
//
// In practice this means a technically sophisticated visitor could bypass
// the app entirely and write spam or vandalize data directly. That's an
// accepted trade-off for a simple, no-login community tool — revisit if
// the site grows, gets targeted by bots, or starts holding anything you'd
// be upset to lose (real accounts via Firebase Authentication would let
// these rules actually check who's writing).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
