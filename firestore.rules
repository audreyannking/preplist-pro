rules_version = '2';

// PrepList Pro - Firestore security rules.
//
// Everything on this site is public study material, so READING is open to
// everyone, signed in or not. That matters for scale: a whole school on one
// network can't all be blocked by Firebase's limit on new anonymous sign-ins
// per IP address, because students only reading never need to sign in.
//
// WRITING still requires the silent anonymous session the app creates (no
// fields, nothing on screen). That's a speed bump, not real security: anyone
// who loads the site gets a session, so a determined visitor could still
// write directly. The Teacher/Admin password in the app is a separate, lighter
// deterrent that isn't enforced here. Real protection would need real
// accounts (Firebase Authentication with credentials).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
